  "database_schema": {
    "tables": [
      {
        "name": "AC_EVENTO",
        "description": "Evento, dimensões da planta, escala (m/px), largura de corredor, origem padrão"
      },
      {
        "name": "AC_AREA",
        "description": "Retângulos da planta (stands, palco, acolhimento) com cor, subtítulo e descrição"
      },
      {
        "name": "AC_PONTO",
        "description": "Nós do grafo (x, y, tipo, bloqueado) + busca_texto e embedding VECTOR(384)"
      },
      {
        "name": "AC_TRECHO",
        "description": "Arestas: distância, escada, acessível, ruído, lotação, valores base, via, bloqueado"
      },
      {
        "name": "AC_PERFIL",
        "description": "Perfis: evita escada, pesos de ruído/lotação, limites, fator de excesso, velocidade"
      },
      {
        "name": "AC_PROGRAMACAO",
        "description": "Agenda por lugar (horário, ruído previsto) — ilustrativa"
      },
      {
        "name": "AC_REPORTE",
        "description": "Crowdsourcing de cheio / barulho / bloqueio / liberado"
      },
      {
        "name": "AC_LEITURA_SENSOR",
        "description": "Contagem por trecho, densidade, nível e horário (retenção de 3 h)"
      },
      {
        "name": "AC_INTENCAO",
        "description": "Tipos de pergunta, necessidade, perfil e social + categorias"
      },
      {
        "name": "AC_INTENCAO_FRASE",
        "description": "Frases de exemplo vetorizadas com VECTOR(384)"
