{
  "openapi": "3.1.0",
  "info": {
    "title": "Rotas Acessíveis · ORDS REST API (Módulo rotas.v1)",
    "version": "1.0.0",
    "description": "Mapeamento completo e dump de dados da API REST do projeto Rotas Acessíveis (Tech4Change 2026 - FIAP). O back-end executa dentro do Oracle Autonomous AI Database 26ai (OCI São Paulo, schema ACESSO_APP) via Oracle REST Data Services (ORDS). Este arquivo permite o funcionamento e simulação completa do front-end mesmo quando a API remota estiver indisponível (modo offline).",
    "contact": {
      "name": "Tech4Change 2026 - FIAP",
      "url": "https://github.com/leonardopetruncko/rotas-acessiveis"
    }
  },
  "servers": [
    {
      "url": "https://oracle-autonomous.oci.sa-saopaulo-1.oraclecloud.com/ords/acesso_app/api/v1",
      "description": "Oracle Autonomous AI Database 26ai - ORDS Production Endpoint"
    },
    {
      "url": "http://localhost:8080/ords/acesso_app/api/v1",
      "description": "Ambiente de Desenvolvimento Local"
    }
  ],
  "metadata": {
    "database": "Oracle Autonomous AI Database 26ai (23.26.3.3.0, OCI São Paulo)",
    "schema": "ACESSO_APP",
    "base_path": "/ords/acesso_app/api/v1/",
    "total_handlers": 18,
    "demonstration_pin": "2026",
    "offline_fallback": {
      "fetch_timeout_ms": 5000,
      "local_engine": "motorLocal.js / pathfinding.ts (espelho de AC_ROTAS em PL/SQL)",
      "storage": "LocalStorage / IndexedDB / JSON Snapshot"
    },
    "ai_embedding_model": {
      "name": "DOC_MODEL (all_MiniLM_L12_v2)",
      "format": "ONNX",
      "dimensions": 384,
      "distance_metric": "COSINE",
      "operators": [
        "VECTOR_EMBEDDING(doc_model USING :t AS data)",
        "VECTOR_DISTANCE(a, b, COSINE)"
      ]
    },
    "optional_llm": {
      "provider": "OCI Generative AI",
      "model": "meta.llama-3.3-70b-instruct",
      "region": "sa-saopaulo-1"
    }
  },
